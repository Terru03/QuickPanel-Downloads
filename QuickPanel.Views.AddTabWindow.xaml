<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="QuickPanel.Views.AddTabWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add tab" Width="420" Height="470" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource PanelBackgroundBrush}" Foreground="{StaticResource PanelTextBrush}" ShowInTaskbar="False" xmlns:views="clr-namespace:QuickPanel.Views;assembly=QuickPanel" Loaded="Window_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="Background" Value="{StaticResource PanelSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource PanelAccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource PanelAccentBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Name="InputBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" FocusVisualStyle="{x:Null}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsFocused" Value="True">
                  <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource PanelAccentBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource PanelPressButtonStyle}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinWidth" Value="78" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="Background" Value="{StaticResource PanelSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ButtonBorder" Property="Background" Value="#1E2230" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ButtonBorder" Property="Background" Value="#252A38" />
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                    </Setter.Value>
                  </Setter>
                  <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PanelAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelAccentBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PanelAccentHoverBrush}" />
                  <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource PanelAccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                    </Setter.Value>
                  </Setter>
                  <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ProfileComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayText}" />
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
              <Border Name="ItemBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="5">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ItemBorder" Property="Background" Value="#222838" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PanelAccentTintBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ProfileComboBoxStyle" TargetType="{x:Type ComboBox}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="10,0,34,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="Background" Value="{StaticResource PanelSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ProfileComboBoxItemStyle}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid>
                <ToggleButton Name="DropDownToggle"
                              Focusable="False"
                              ClickMode="Press"
                              Background="{StaticResource PanelSurfaceBrush}"
                              BorderBrush="{StaticResource PanelBorderBrush}"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                      <Border Name="InputBorder"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="1"
                              CornerRadius="6">
                        <Grid>
                          <Border Width="30" HorizontalAlignment="Right" Background="Transparent" />
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="InputBorder" Property="BorderBrush" Value="#384156" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource PanelAccentBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <TextBlock Margin="{TemplateBinding Padding}"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PanelTextBrush}"
                           Text="{Binding SelectedItem.DisplayText, RelativeSource={RelativeSource TemplatedParent}}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,0,11,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="11"
                           Foreground="{StaticResource PanelMutedTextBrush}"
                           Text="&#xE70D;" />
                <Popup Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       Placement="Bottom"
                       PopupAnimation="Fade">
                  <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                          MaxHeight="220"
                          Margin="0,3,0,0"
                          Padding="4"
                          Background="{StaticResource PanelSurfaceBrush}"
                          BorderBrush="{StaticResource PanelBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{StaticResource PanelAccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.55" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="22,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Name="HeadingText" FontSize="16" FontWeight="SemiBold" Text="Add a tab" />
    <TextBlock Grid.Row="1" Margin="0,14,0,5" FontSize="11" FontWeight="Medium" Foreground="{StaticResource PanelMutedTextBrush}" Text="NAME" />
    <TextBox Name="NameTextBox" Grid.Row="2" AutomationProperties.Name="Tab name" MaxLength="40" TextChanged="AnyTextBox_TextChanged" />
    <TextBlock Grid.Row="3" Margin="0,11,0,5" FontSize="11" FontWeight="Medium" Foreground="{StaticResource PanelMutedTextBrush}" Text="URL" />
    <TextBox Name="UrlTextBox" Grid.Row="4" AutomationProperties.Name="Tab URL" VerticalAlignment="Top" TextChanged="AnyTextBox_TextChanged" />
    <TextBlock Grid.Row="5" Margin="0,11,0,5" FontSize="11" FontWeight="Medium" Foreground="{StaticResource PanelMutedTextBrush}" Text="ICON (OPTIONAL)" />
    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Width="34" Height="34" Margin="0,0,8,0" Background="{StaticResource PanelSurfaceBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6">
        <Border Name="IconPreviewHost" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBox Grid.Column="1" Name="IconTextBox" AutomationProperties.Name="Tab icon" ToolTip="Leave blank for automatic icon, or enter a brand name, SVG URL, SVG path, or raw SVG." TextChanged="AnyTextBox_TextChanged" />
      <Button Grid.Column="2" Margin="6,0,0,0" MinWidth="72" Content="Browse…" Click="BrowseIconButton_Click" />
    </Grid>
    <TextBlock Grid.Row="7" Margin="0,5,0,0" FontSize="10.5" Foreground="{StaticResource PanelMutedTextBrush}" Text="Blank = automatic. Try reddit, an SVG URL, or choose an SVG file." />
    <TextBlock Grid.Row="8" Margin="0,11,0,5" FontSize="11" FontWeight="Medium" Foreground="{StaticResource PanelMutedTextBrush}" Text="BROWSING PROFILE" />
    <ComboBox Name="ProfileComboBox" Grid.Row="9" Style="{StaticResource ProfileComboBoxStyle}" AutomationProperties.Name="Browsing profile" DisplayMemberPath="DisplayText" SelectionChanged="ProfileComboBox_SelectionChanged" />
    <TextBlock Name="ProfileDescriptionText" Grid.Row="10" Margin="0,5,0,0" FontSize="10.5" Foreground="{StaticResource PanelMutedTextBrush}" Text="Shares logins and cookies with your existing tabs." TextWrapping="Wrap" />
    <TextBlock Name="ValidationMessage" Grid.Row="11" Margin="0,5,0,0" FontSize="11" Foreground="#E05555" TextWrapping="Wrap" Visibility="Collapsed" />
    <StackPanel Grid.Row="13" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button Content="Cancel" IsCancel="True" Click="CancelButton_Click" />
      <Button Name="AddButton" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Content="Add tab" Click="AddButton_Click" />
    </StackPanel>
  </Grid>
</Window>
