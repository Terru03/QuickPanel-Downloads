<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="QuickPanel.Views.ProfileMigrationRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile recovery"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource PanelChromeBrush}"
        Foreground="{StaticResource PanelTextBrush}"
        ShowInTaskbar="True"
        Topmost="True"
        Loaded="Window_Loaded">
  <Window.Resources>
    <Style x:Key="RecoveryButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelPressButtonStyle}">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="112" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
      <Setter Property="Background" Value="#1A2030" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#252C3C" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#56617A" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource PanelAccentBrush}" />
                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource PanelChromeBrush}"
          BorderBrush="{StaticResource PanelBorderBrush}"
          BorderThickness="1"
          CornerRadius="12">
    <Grid ClipToBounds="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="64" />
      </Grid.RowDefinitions>

      <Border BorderBrush="{StaticResource PanelBorderSubtleBrush}"
              BorderThickness="0,0,0,1"
              CornerRadius="12,12,0,0">
        <Grid Margin="16,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="30" Height="30" Background="#352B17" BorderBrush="#6C5726" BorderThickness="1" CornerRadius="8">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="15"
                       Foreground="#F4C15D"
                       Text="&#xE7BA;" />
          </Border>
          <TextBlock Grid.Column="1"
                     Margin="11,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Text="Quick Panel profile recovery" />
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="22,20,22,20">
        <TextBlock FontSize="18"
                   FontWeight="SemiBold"
                   Text="Your sign-ins and settings were protected" />
        <TextBlock x:Name="MessageText"
                   Margin="0,8,0,0"
                   FontSize="12"
                   LineHeight="18"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource PanelMutedTextBrush}" />
        <Border Margin="0,16,0,0"
                Padding="12,10"
                Background="#10141D"
                BorderBrush="{StaticResource PanelBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8">
          <StackPanel>
            <TextBlock FontSize="10" Foreground="{StaticResource PanelMutedTextBrush}" Text="CANONICAL PROFILE" />
            <TextBlock x:Name="CanonicalPathText" Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,10,0,0" FontSize="10" Foreground="{StaticResource PanelMutedTextBrush}" Text="LEGACY OR RECOVERY PROFILE" />
            <TextBlock x:Name="RecoveryPathText" Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
        <TextBlock Margin="0,12,0,0"
                   FontSize="11"
                   LineHeight="17"
                   TextWrapping="Wrap"
                   Foreground="#C9D2E5"
                   Text="Quick Panel stopped before opening WebView2. No legacy profile was deleted or overwritten." />
      </StackPanel>

      <Border Grid.Row="2"
              Padding="16,0"
              Background="#0F141E"
              BorderBrush="{StaticResource PanelBorderSubtleBrush}"
              BorderThickness="0,1,0,0"
              CornerRadius="0,0,12,12">
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
          <Button Margin="0,0,8,0"
                  Style="{StaticResource RecoveryButtonStyle}"
                  Content="Open diagnostics"
                  Click="OpenDiagnosticsButton_Click" />
          <Button x:Name="ExitButton"
                  Style="{StaticResource RecoveryButtonStyle}"
                  Background="{StaticResource PanelAccentBrush}"
                  BorderBrush="{StaticResource PanelAccentBrush}"
                  Content="Exit safely"
                  IsDefault="True"
                  IsCancel="True"
                  Click="ExitButton_Click" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
