<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="QuickPanel.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" Title="Quick Panel" Icon="quickpanel.ico" Width="500" Height="650" MinWidth="420" MinHeight="400" WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="{StaticResource PanelChromeBrush}" Foreground="{StaticResource PanelTextBrush}" Topmost="True" SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged" Activated="Window_Activated" Closing="Window_Closing" Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PanelPressButtonStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="1,0,0,0" />
        <Setter Property="Foreground" Value="{StaticResource PanelMutedTextBrush}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ButtonBorder" Property="Background" Value="#1E2230" />
                  <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ButtonBorder" Property="Background" Value="#252A38" />
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                    </Setter.Value>
                  </Setter>
                  <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.35" />
                  <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type TabControl}" TargetType="{x:Type TabControl}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabControl}">
              <Grid ClipToBounds="True" SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                  <RowDefinition Height="36" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,28,0">
                  <ScrollViewer Name="HeaderScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" CanContentScroll="False" Focusable="False" ScrollChanged="HeaderScrollViewer_ScrollChanged">
                    <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" Margin="4,0,0,0" />
                  </ScrollViewer>
                  <Rectangle Name="TabStripFade" Width="36" HorizontalAlignment="Right" IsHitTestVisible="False" Visibility="Collapsed">
                    <Rectangle.Fill>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00111318" Offset="0" />
                        <GradientStop Color="#FF111318" Offset="1" />
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>
                </Grid>
                <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{StaticResource PanelBorderSubtleBrush}" BorderThickness="0,1,0,0" ClipToBounds="True" SnapsToDevicePixels="True">
                  <Grid ClipToBounds="True" SnapsToDevicePixels="True">
                    <ContentPresenter Name="PART_SelectedContentHost" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" ContentStringFormat="{TemplateBinding SelectedContentStringFormat}" ClipToBounds="True" SnapsToDevicePixels="True" />
                  </Grid>
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource PanelMutedTextBrush}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Width" Value="42" />
        <Setter Property="MinWidth" Value="42" />
        <Setter Property="MaxWidth" Value="42" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabItem}">
              <Grid Margin="1,3,1,2" ClipToBounds="True">
                <Border Name="TabBackground"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="8">
                  <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Name="SelectionRail"
                        Height="2"
                        Margin="9,0"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource PanelAccentBrush}"
                        CornerRadius="1"
                        Opacity="0" />
                <Border Name="TabDivider"
                        Width="1"
                        Height="15"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{StaticResource PanelBorderSubtleBrush}" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="TabBackground" Property="Background" Value="#171B27" />
                  <Setter TargetName="TabBackground" Property="BorderBrush" Value="{StaticResource PanelBorderSubtleBrush}" />
                  <Setter TargetName="TabDivider" Property="Visibility" Value="Collapsed" />
                  <Setter Property="Foreground" Value="#B0B8C8" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="TabBackground" Property="Background" Value="{StaticResource PanelAccentTintBrush}" />
                  <Setter TargetName="TabBackground" Property="BorderBrush" Value="#35405B" />
                  <Setter TargetName="SelectionRail" Property="Opacity" Value="1" />
                  <Setter TargetName="TabDivider" Property="Visibility" Value="Collapsed" />
                  <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="TabBackground" Property="Background" Value="{StaticResource PanelAccentTintHoverBrush}" />
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Background="{StaticResource PanelChromeBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,1,1" CornerRadius="10" ClipToBounds="True">
    <Grid ClipToBounds="True" SnapsToDevicePixels="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border x:Name="FocusSink"
              Width="1"
              Height="1"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Focusable="True"
              IsHitTestVisible="False"
              Opacity="0"
              Panel.ZIndex="50" />
      <Grid Row="0" Background="{StaticResource PanelChromeBrush}" ClipToBounds="True" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#00FFFFFF">
          <StackPanel Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
            <Image Width="17" Height="17" Margin="0,0,6,0" Source="Assets/AppLogo.png" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Normal" Foreground="{StaticResource PanelMutedTextBrush}" Text="Quick Panel" />
            <Border Name="TitleNavigationDivider" Width="1" Height="14" Margin="10,0,5,0" Background="{StaticResource PanelBorderSubtleBrush}" Visibility="Collapsed" />
            <Button Name="TitleBackButton" AutomationProperties.Name="Back" ToolTip="Back (Alt+Left in page)" Style="{StaticResource TitleBarButtonStyle}" Content="&lt;" FontSize="12" Visibility="Collapsed" Click="TitleBackButton_Click" />
            <Button Name="TitleForwardButton" AutomationProperties.Name="Forward" ToolTip="Forward (Alt+Right in page)" Style="{StaticResource TitleBarButtonStyle}" Content="&gt;" FontSize="12" Visibility="Collapsed" Click="TitleForwardButton_Click" />
            <Button Name="TitleHomeButton" AutomationProperties.Name="Home" ToolTip="Home" Style="{StaticResource TitleBarButtonStyle}" Content="⌂" FontSize="14" Visibility="Collapsed" Click="TitleHomeButton_Click" />
            <Button Name="TitleReloadButton" AutomationProperties.Name="Reload" ToolTip="Reload current tab (Ctrl+R / F5)" Style="{StaticResource TitleBarButtonStyle}" Content="↻" FontSize="13" Visibility="Collapsed" Click="TitleReloadButton_Click" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" Margin="0,0,5,0" VerticalAlignment="Center" Orientation="Horizontal">
          <Button AutomationProperties.Name="Settings" ToolTip="Settings" Style="{StaticResource TitleBarButtonStyle}" Click="SettingsButton_Click">
            <Viewbox Width="14" Height="14">
              <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Data="M19.43,12.98 C19.47,12.66 19.5,12.34 19.5,12 C19.5,11.66 19.47,11.34 19.43,11.02 L21.54,9.37 C21.73,9.22 21.78,8.95 21.66,8.73 L19.66,5.27 C19.54,5.05 19.27,4.96 19.05,5.05 L16.56,6.05 C16.04,5.66 15.48,5.32 14.87,5.07 L14.5,2.42 C14.47,2.18 14.25,2 14,2 L10,2 C9.75,2 9.54,2.18 9.5,2.42 L9.13,5.07 C8.52,5.32 7.96,5.66 7.44,6.05 L4.95,5.05 C4.72,4.97 4.46,5.05 4.34,5.27 L2.34,8.73 C2.21,8.95 2.27,9.22 2.46,9.37 L4.57,11.02 C4.53,11.34 4.5,11.67 4.5,12 C4.5,12.33 4.53,12.66 4.57,12.98 L2.46,14.63 C2.27,14.78 2.21,15.05 2.34,15.27 L4.34,18.73 C4.46,18.95 4.73,19.04 4.95,18.95 L7.44,17.95 C7.96,18.35 8.52,18.68 9.13,18.93 L9.5,21.58 C9.54,21.82 9.75,22 10,22 L14,22 C14.25,22 14.47,21.82 14.5,21.58 L14.87,18.93 C15.48,18.68 16.04,18.34 16.56,17.95 L19.05,18.95 C19.28,19.03 19.54,18.95 19.66,18.73 L21.66,15.27 C21.78,15.05 21.73,14.78 21.54,14.63 L19.43,12.98 M12,15.5 C10.07,15.5 8.5,13.93 8.5,12 C8.5,10.07 10.07,8.5 12,8.5 C13.93,8.5 15.5,10.07 15.5,12 C15.5,13.93 13.93,15.5 12,15.5 Z" />
            </Viewbox>
          </Button>
          <Button AutomationProperties.Name="Dock a window" ToolTip="Dock a window" Style="{StaticResource TitleBarButtonStyle}" Click="DockWindowButton_Click">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Text="&#xE8A7;" />
          </Button>
          <Button AutomationProperties.Name="Add a tab" ToolTip="Add tab (Ctrl+T)" Style="{StaticResource TitleBarButtonStyle}" Content="+" FontSize="16" FontWeight="Light" Click="AddTabButton_Click" />
          <primitives:Thumb x:Name="PanelResizeThumb"
                            Width="28"
                            Height="26"
                            Margin="1,0,0,0"
                            AutomationProperties.Name="Resize Quick Panel"
                            ToolTip="Drag diagonally to resize Quick Panel"
                            Cursor="SizeNWSE"
                            Background="Transparent"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            DragStarted="PanelResizeThumb_DragStarted"
                            DragCompleted="PanelResizeThumb_DragCompleted"
                            DragDelta="PanelResizeThumb_DragDelta">
            <primitives:Thumb.Template>
              <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                <Border x:Name="ResizeThumbBackground" Background="Transparent" CornerRadius="5">
                  <Path Width="12"
                        Height="12"
                        Data="M1,11 L11,1 M5,11 L11,5 M9,11 L11,9"
                        Stroke="{StaticResource PanelMutedTextBrush}"
                        StrokeThickness="1"
                        Opacity="0.72"
                        Stretch="None" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ResizeThumbBackground" Property="Background" Value="#1E2230" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </primitives:Thumb.Template>
          </primitives:Thumb>
          <Button AutomationProperties.Name="Hide panel" ToolTip="Hide panel (Esc)" Style="{StaticResource TitleBarButtonStyle}" Content="–" Click="HideButton_Click" />
        </StackPanel>
      </Grid>
      <Border x:Name="SetupWarningBanner" Grid.Row="1" Margin="9,9,9,9" Padding="11,9" Background="#241A1A" BorderBrush="#3D2828" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="18" Height="18" VerticalAlignment="Top" Background="#3D2828" CornerRadius="9">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#E0A0A0" Text="!" />
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,8,0">
            <TextBlock x:Name="SetupWarningTitle" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource PanelTextBrush}" Text="Setup warning" />
            <TextBlock x:Name="SetupWarningMessage" Margin="0,2,0,0" FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource PanelMutedTextBrush}" />
          </StackPanel>
          <Button Grid.Column="2" Width="22" Height="22" VerticalAlignment="Top" Padding="0" FontSize="13" Style="{StaticResource TitleBarButtonStyle}" Content="×" Click="SetupWarningBanner_CloseClick" />
        </Grid>
      </Border>
      <TabControl Name="AiTabs" Grid.Row="2" Padding="0" AllowDrop="True" Background="{StaticResource PanelBackgroundBrush}" SelectionChanged="AiTabs_SelectionChanged" PreviewMouseLeftButtonDown="AiTabs_PreviewMouseLeftButtonDown" PreviewMouseMove="AiTabs_PreviewMouseMove" PreviewMouseWheel="AiTabs_PreviewMouseWheel" DragOver="AiTabs_DragOver" Drop="AiTabs_Drop" />
      <Button Name="TabOverflowButton" Grid.Row="2" AutomationProperties.Name="Tabs and built-in panels" Width="28" Height="34" Margin="0,1,4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="20" ToolTip="Tabs and built-in panels" Style="{StaticResource TitleBarButtonStyle}" Content="⋯" FontSize="14" Click="TabOverflowButton_Click" />
      <Grid x:Name="ExternalAppLayer" Grid.Row="2" Panel.ZIndex="10" ClipToBounds="True" SnapsToDevicePixels="True" IsHitTestVisible="False" />
    </Grid>
  </Border>
</Window>
