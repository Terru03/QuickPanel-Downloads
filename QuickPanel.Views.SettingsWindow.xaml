<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="QuickPanel.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" Height="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{StaticResource PanelChromeBrush}" Foreground="{StaticResource PanelTextBrush}"
        ShowInTaskbar="False" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown" Closed="Window_Closed">
  <Window.Resources>
    <Style x:Key="SettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelPressButtonStyle}">
      <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="15,0"/>
      <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}"/>
      <Setter Property="Background" Value="{StaticResource PanelSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#252A38"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Width" Value="40"/><Setter Property="Height" Value="22"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Width="40" Height="22">
          <Border x:Name="Track" Background="#2A3040" BorderBrush="#394154" BorderThickness="1" CornerRadius="11"/>
          <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="3,3,21,3" HorizontalAlignment="Stretch" Fill="#AAB2C2"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Track" Property="Background" Value="#4F7AFF"/><Setter TargetName="Track" Property="BorderBrush" Value="#4F7AFF"/>
            <Setter TargetName="Thumb" Property="Fill" Value="White"/><Setter TargetName="Thumb" Property="Margin" Value="21,3,3,3"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource PanelAccentHoverBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="SettingsCardStyle" TargetType="Border">
      <Setter Property="Margin" Value="0,8,0,0"/><Setter Property="Padding" Value="14,12"/>
      <Setter Property="Background" Value="{StaticResource PanelSurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource PanelBorderSubtleBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
      <Setter Property="Height" Value="30"/><Setter Property="Padding" Value="8,5"/><Setter Property="Foreground" Value="{StaticResource PanelTextBrush}"/>
      <Setter Property="Background" Value="#121620"/><Setter Property="BorderBrush" Value="{StaticResource PanelBorderSubtleBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="{StaticResource PanelTextBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="Foreground" Value="{StaticResource PanelMutedTextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="NavBorder" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#171C28"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{StaticResource PanelAccentTintBrush}"/><Setter Property="Foreground" Value="#D8E1FF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource PanelChromeBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12">
    <Grid ClipToBounds="True">
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
      <Border Grid.Row="0" BorderBrush="{StaticResource PanelBorderSubtleBrush}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="15,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="26" Height="26" Background="{StaticResource PanelAccentTintBrush}" CornerRadius="7"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource PanelAccentBrush}" Text="⚙"/></Border>
          <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Settings"/>
          <Button Grid.Column="2" AutomationProperties.Name="Close settings" Width="28" Height="28" ToolTip="Close" Style="{StaticResource SettingsButtonStyle}" Padding="0" BorderThickness="0" Background="Transparent" Content="×" FontSize="17" IsCancel="True" Click="CloseButton_Click"/>
        </Grid>
      </Border>

      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Padding="10,14" BorderBrush="{StaticResource PanelBorderSubtleBrush}" BorderThickness="0,0,1,0">
          <ListBox x:Name="SettingsCategoryList" Background="Transparent" BorderThickness="0" SelectionChanged="SettingsCategoryList_SelectionChanged" ItemContainerStyle="{StaticResource SettingsNavItemStyle}">
            <ListBoxItem Content="General" Tag="General" IsSelected="True"/><ListBoxItem Content="Performance" Tag="Performance"/><ListBoxItem Content="Keyboard" Tag="Keyboard"/><ListBoxItem Content="Privacy" Tag="Privacy"/><ListBoxItem Content="Updates" Tag="Updates"/><ListBoxItem Content="Advanced" Tag="Advanced"/>
          </ListBox>
        </Border>

        <Grid Grid.Column="1" Margin="16,14,16,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBox x:Name="SettingsSearchTextBox" Style="{StaticResource SettingsTextBoxStyle}" Height="34" ToolTip="Search settings" TextChanged="SettingsSearchTextBox_TextChanged"/>
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Border x:Name="SearchResultsBorder" Visibility="Collapsed" Background="{StaticResource PanelChromeBrush}"><ListBox x:Name="SearchResultsList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource PanelTextBrush}" DisplayMemberPath="DisplayText" MouseDoubleClick="SearchResultsList_MouseDoubleClick" PreviewKeyDown="SearchResultsList_PreviewKeyDown"/></Border>

            <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Auto" Focusable="False"><StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="General"/><TextBlock Margin="0,3,0,5" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="Quick Panel behaviour and startup."/>
              <Border Style="{StaticResource SettingsCardStyle}" MouseLeftButtonUp="AlwaysOnTopCard_MouseLeftButtonUp"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="13" FontWeight="SemiBold" Text="Always on top"/><TextBlock Margin="0,3,14,0" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="Keep Quick Panel above other windows."/></StackPanel><CheckBox x:Name="AlwaysOnTopCheckBox" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"/></Grid></Border>
              <Border Style="{StaticResource SettingsCardStyle}" MouseLeftButtonUp="StartWithWindowsCard_MouseLeftButtonUp"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="13" FontWeight="SemiBold" Text="Start Quick Panel with Windows"/><TextBlock Margin="0,3,14,0" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="Creates a normal per-user Startup folder shortcut."/></StackPanel><CheckBox x:Name="StartWithWindowsCheckBox" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"/></Grid></Border>
              <Border Style="{StaticResource SettingsCardStyle}" MouseLeftButtonUp="LaunchCodexAutomaticallyCard_MouseLeftButtonUp"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="13" FontWeight="SemiBold" Text="Launch Codex automatically"/><TextBlock Margin="0,3,14,0" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="If enabled, startup waits before docking Codex."/></StackPanel><CheckBox x:Name="LaunchCodexAutomaticallyCheckBox" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"/></Grid></Border>
            </StackPanel></ScrollViewer>

            <ScrollViewer x:Name="PerformancePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False"><StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="Performance"/><TextBlock Margin="0,3,0,5" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="Control inactive web tabs and watch resource use."/>
              <Border Style="{StaticResource SettingsCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="13" FontWeight="SemiBold" Text="Sleep inactive web tabs"/><TextBlock Margin="0,3,14,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource PanelMutedTextBrush}" Text="Choose a preset or type any number of minutes. Right-click a web tab for a per-tab override."/></StackPanel><ComboBox x:Name="TabSleepComboBox" Grid.Column="1" Width="118" Height="30" IsEditable="True" VerticalAlignment="Center"/></Grid></Border>
              <Border Style="{StaticResource SettingsCardStyle}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="13" FontWeight="SemiBold" Text="Resource monitor"/><TextBlock Margin="0,3,14,0" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="Live Quick Panel and WebView2 resource snapshot."/></StackPanel><Button Grid.Column="1" Style="{StaticResource SettingsButtonStyle}" Content="Refresh" Click="ResourceMonitorRefreshButton_Click"/></Grid><Border Margin="0,10,0,0" Padding="10" Background="#0D111A" BorderBrush="{StaticResource PanelBorderSubtleBrush}" BorderThickness="1" CornerRadius="7"><TextBlock x:Name="ResourceMonitorText" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource PanelMutedTextBrush}" Text="Loading resource data…"/></Border></StackPanel></Border>
            </StackPanel></ScrollViewer>

            <ScrollViewer x:Name="KeyboardPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False"><StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="Keyboard"/><TextBlock Margin="0,3,0,5" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="Global and in-panel shortcuts."/>
              <Border Style="{StaticResource SettingsCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="13" FontWeight="SemiBold" Text="Show or hide panel"/><TextBlock Margin="0,3,14,0" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="Works from any app."/></StackPanel><Border Grid.Column="1" Padding="9,5" VerticalAlignment="Center" Background="{StaticResource PanelAccentTintBrush}" BorderBrush="#405FAF" BorderThickness="1" CornerRadius="5"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#BFD0FF" Text="Ctrl + Alt + G"/></Border></Grid></Border>
              <Border Style="{StaticResource SettingsCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="13" FontWeight="SemiBold" Text="Quick Command"/><TextBlock Margin="0,3,14,0" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="Search tabs and Quick Panel actions."/></StackPanel><Border Grid.Column="1" Padding="9,5" VerticalAlignment="Center" Background="{StaticResource PanelAccentTintBrush}" BorderBrush="#405FAF" BorderThickness="1" CornerRadius="5"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#BFD0FF" Text="Ctrl + K"/></Border></Grid></Border>
            </StackPanel></ScrollViewer>

            <ScrollViewer x:Name="PrivacyPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False"><StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="Privacy"/><TextBlock Margin="0,3,0,5" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="Local browsing data controls."/>
              <Border Style="{StaticResource SettingsCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="13" FontWeight="SemiBold" Text="WebView2 browsing data"/><TextBlock Margin="0,3,14,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource PanelMutedTextBrush}" Text="Clear cookies, cache, history, and site data for the selected tab's browsing profile."/></StackPanel><Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingsButtonStyle}" Content="Clear…" Click="ClearBrowsingDataButton_Click"/></Grid></Border>
            </StackPanel></ScrollViewer>

            <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False"><StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="Updates"/><TextBlock Margin="0,3,0,5" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="Check, install and recover Quick Panel versions."/>
              <Border Style="{StaticResource SettingsCardStyle}"><StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock FontSize="13" FontWeight="SemiBold" Text="Updates"/><Border x:Name="UpdateBadge" Margin="8,0,0,0" Padding="6,2" VerticalAlignment="Center" Background="{StaticResource PanelAccentTintBrush}" BorderBrush="#405FAF" BorderThickness="1" CornerRadius="6" Visibility="Collapsed"><TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#BFD0FF" Text="Update"/></Border></StackPanel><TextBlock x:Name="CurrentVersionText" Margin="0,3,14,0" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}"/></StackPanel><Button x:Name="CheckForUpdatesButton" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingsButtonStyle}" Content="Check for updates" Click="CheckForUpdatesButton_Click"/></Grid>
                <Border Margin="0,10,0,0" Padding="0,2,0,0" MouseLeftButtonUp="CheckUpdatesOnStartupCard_MouseLeftButtonUp"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="12" FontWeight="SemiBold" Text="Check for updates on startup"/><TextBlock Margin="0,3,14,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource PanelMutedTextBrush}" Text="Quietly checks GitHub releases."/></StackPanel><CheckBox x:Name="CheckUpdatesOnStartupCheckBox" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"/></Grid></Border>
                <TextBox x:Name="UpdateManifestUrlTextBox" Margin="0,10,0,0" Style="{StaticResource SettingsTextBoxStyle}" ToolTip="Optional public version.json URL override"/>
                <TextBlock x:Name="UpdateStatusText" Margin="0,7,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource PanelMutedTextBrush}" Text="Checks GitHub releases by default."/>
                <Border x:Name="ReleaseNotesBorder" Margin="0,9,0,0" Padding="10,8" Background="#0D111A" BorderBrush="{StaticResource PanelBorderSubtleBrush}" BorderThickness="1" CornerRadius="7" Visibility="Collapsed"><TextBlock x:Name="ReleaseNotesText" MaxHeight="110" FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource PanelMutedTextBrush}"/></Border>
                <ProgressBar x:Name="DownloadProgressBar" Margin="0,9,0,0" Height="3" Minimum="0" Maximum="100" Foreground="{StaticResource PanelAccentBrush}" Background="#1E2230" BorderThickness="0" Visibility="Collapsed"/>
                <WrapPanel Margin="0,10,0,0"><Button x:Name="DownloadUpdateButton" Margin="0,0,8,8" Style="{StaticResource SettingsButtonStyle}" Content="Download update" IsEnabled="False" Click="DownloadUpdateButton_Click"/><Button x:Name="ReleaseNotesButton" Margin="0,0,8,8" Style="{StaticResource SettingsButtonStyle}" Content="Open release" IsEnabled="False" Click="OpenReleaseNotesButton_Click"/><Button x:Name="CancelDownloadButton" Margin="0,0,8,8" Style="{StaticResource SettingsButtonStyle}" Content="Cancel" Visibility="Collapsed" Click="CancelDownloadButton_Click"/><Button x:Name="RollbackUpdateButton" Margin="0,0,0,8" Style="{StaticResource SettingsButtonStyle}" Content="Rollback" Click="RollbackUpdateButton_Click"/></WrapPanel>
              </StackPanel></Border>
            </StackPanel></ScrollViewer>

            <ScrollViewer x:Name="AdvancedPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False"><StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="Advanced"/><TextBlock Margin="0,3,0,5" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="Diagnostics, backups and recovery tools."/>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0,8,0,18"><StackPanel><WrapPanel><Button Margin="0,0,8,8" Style="{StaticResource SettingsButtonStyle}" Content="Copy diagnostics" Click="CopyDiagnosticsButton_Click"/><Button Margin="0,0,8,8" Style="{StaticResource SettingsButtonStyle}" Content="Disable startup" Click="DisableStartupButton_Click"/><Button Margin="0,0,8,8" Style="{StaticResource SettingsButtonStyle}" Content="Open settings folder" Click="OpenSettingsFolderButton_Click"/><Button Margin="0,0,8,8" Style="{StaticResource SettingsButtonStyle}" Content="Export backup" Click="ExportSettingsBackupButton_Click"/><Button Margin="0,0,8,8" Style="{StaticResource SettingsButtonStyle}" Content="Import backup" Click="ImportSettingsBackupButton_Click"/><Button Margin="0,0,8,8" Style="{StaticResource SettingsButtonStyle}" Content="Restore previous backup" Click="RestorePreviousBackupButton_Click"/><Button Margin="0,0,0,8" Style="{StaticResource SettingsButtonStyle}" Content="Reset layout" Click="ResetLayoutButton_Click"/></WrapPanel><TextBlock x:Name="AdvancedStatusText" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource PanelMutedTextBrush}" Text="No cookies, tokens, or browsing data in diagnostics."/><Border Margin="0,10,0,0" Padding="10" Background="#0D111A" BorderBrush="{StaticResource PanelBorderSubtleBrush}" BorderThickness="1" CornerRadius="7"><TextBlock x:Name="DiagnosticsText" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource PanelMutedTextBrush}"/></Border></StackPanel></Border>
            </StackPanel></ScrollViewer>
          </Grid>
        </Grid>
      </Grid>

      <Grid Grid.Row="2" Margin="16,0"><TextBlock x:Name="VersionText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}"/><Button x:Name="SaveButton" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SettingsButtonStyle}" Content="Done" IsDefault="True" Click="SaveButton_Click"/></Grid>
    </Grid>
  </Border>
</Window>
