<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="QuickPanel.Views.DockWindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dock a window"
        Width="520"
        Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource PanelChromeBrush}"
        Foreground="{StaticResource PanelTextBrush}"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="PickerButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelPressButtonStyle}">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
      <Setter Property="Background" Value="{StaticResource PanelSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#252A38" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PickerPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PickerButtonStyle}">
      <Setter Property="Background" Value="{StaticResource PanelAccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource PanelAccentHoverBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource PanelAccentHoverBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PickerSearchStyle" TargetType="TextBox">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
      <Setter Property="Background" Value="#121620" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{StaticResource PanelTextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="InputBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource PanelAccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PickerItemStyle" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{StaticResource PanelSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Card"
                    Padding="12,11"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="#1E2330" />
                <Setter TargetName="Card" Property="BorderBrush" Value="#343B4B" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource PanelAccentTintBrush}" />
                <Setter TargetName="Card" Property="BorderBrush" Value="#526FB5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource PanelChromeBrush}"
          BorderBrush="{StaticResource PanelBorderBrush}"
          BorderThickness="1"
          CornerRadius="12">
    <Grid ClipToBounds="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="58" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" BorderBrush="{StaticResource PanelBorderSubtleBrush}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="14,0,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="28" Height="28" Background="{StaticResource PanelAccentTintBrush}" CornerRadius="7">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="14"
                       Foreground="{StaticResource PanelAccentBrush}"
                       Text="&#xE8A7;" />
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Dock a window" />
            <TextBlock FontSize="10.5" Foreground="{StaticResource PanelMutedTextBrush}" Text="Pick an open window or launch an installed app" />
          </StackPanel>
          <Button Grid.Column="2"
                  AutomationProperties.Name="Close window picker"
                  Width="30"
                  Height="30"
                  Padding="0"
                  FontSize="17"
                  Background="Transparent"
                  BorderThickness="0"
                  Style="{StaticResource PickerButtonStyle}"
                  Content="×"
                  IsCancel="True"
                  Click="CancelButton_Click" />
        </Grid>
      </Border>

      <TextBlock x:Name="ModeDescriptionText"
                 Grid.Row="1"
                 Margin="16,13,16,10"
                 FontSize="11"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource PanelMutedTextBrush}"
                 Text="Choose a window below. Quick Panel restores its normal frame and position when you undock or close the tab." />

      <Grid Grid.Row="2" Margin="16,0,16,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="36" />
          <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8" Orientation="Horizontal">
          <Button x:Name="WindowsModeButton"
                  MinWidth="112"
                  Height="28"
                  Padding="12,0"
                  AutomationProperties.Name="Show open windows"
                  Style="{StaticResource PickerButtonStyle}"
                  Content="Open windows"
                  Click="WindowsModeButton_Click" />
          <Button x:Name="AppsModeButton"
                  MinWidth="112"
                  Height="28"
                  Margin="8,0,0,0"
                  Padding="12,0"
                  AutomationProperties.Name="Show installed apps"
                  Style="{StaticResource PickerButtonStyle}"
                  Content="Installed apps"
                  Click="AppsModeButton_Click" />
        </StackPanel>
        <TextBox x:Name="SearchTextBox"
                 Grid.Row="1"
                 AutomationProperties.Name="Search open windows"
                 Style="{StaticResource PickerSearchStyle}"
                 ToolTip="Search by window title, app, or window type"
                 TextChanged="SearchTextBox_TextChanged" />
        <Button x:Name="RefreshButton"
                Grid.Row="1"
                Grid.Column="1"
                Margin="8,0,0,0"
                AutomationProperties.Name="Refresh open windows"
                Style="{StaticResource PickerButtonStyle}"
                Content="Refresh"
                Click="RefreshButton_Click" />
      </Grid>

      <Grid Grid.Row="3" Margin="16,0,16,0">
        <ListBox x:Name="WindowList"
                 AutomationProperties.Name="Open windows"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemContainerStyle="{StaticResource PickerItemStyle}"
                 SelectionChanged="WindowList_SelectionChanged"
                 MouseDoubleClick="WindowList_MouseDoubleClick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="42" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Background="#11151E" BorderBrush="{StaticResource PanelBorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                  <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding Icon}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                  <TextBlock FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                  <TextBlock Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource PanelMutedTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding AppDetails}" />
                  <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#717B8F" TextTrimming="CharacterEllipsis" Text="{Binding CompatibilityReason}" />
                </StackPanel>
                <Border x:Name="StatusPill" Grid.Column="2" Padding="7,3" VerticalAlignment="Center" Background="#173626" BorderBrush="#265D3A" BorderThickness="1" CornerRadius="7">
                  <TextBlock x:Name="StatusText" FontSize="10" FontWeight="SemiBold" Foreground="#72D99A" Text="{Binding CompatibilityLabel}" />
                </Border>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CompatibilityLevel}" Value="Try">
                  <Setter TargetName="StatusPill" Property="Background" Value="#342C18" />
                  <Setter TargetName="StatusPill" Property="BorderBrush" Value="#66552A" />
                  <Setter TargetName="StatusText" Property="Foreground" Value="#E2C36B" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ListBox x:Name="AppList"
                 AutomationProperties.Name="Installed apps"
                 Background="Transparent"
                 BorderThickness="0"
                 Visibility="Collapsed"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemContainerStyle="{StaticResource PickerItemStyle}"
                 SelectionChanged="AppList_SelectionChanged"
                 MouseDoubleClick="AppList_MouseDoubleClick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="42" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Background="#11151E" BorderBrush="{StaticResource PanelBorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                  <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding Icon}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                  <TextBlock FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                  <TextBlock Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource PanelMutedTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding AppDetails}" />
                  <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#717B8F" Text="Launch only when you choose it." />
                </StackPanel>
                <Border Grid.Column="2" Padding="7,3" VerticalAlignment="Center" Background="#182B3B" BorderBrush="#294C67" BorderThickness="1" CornerRadius="7">
                  <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#7CC7F2" Text="Open" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel x:Name="EmptyState" Width="320" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="No windows found" />
          <TextBlock x:Name="EmptyStateMessage" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="Open an app, photo, PDF, or video, then choose Refresh." />
        </StackPanel>

        <StackPanel x:Name="LoadingState" Width="280" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ProgressBar Height="3" IsIndeterminate="True" Foreground="{StaticResource PanelAccentBrush}" Background="#1E2230" BorderThickness="0" />
          <TextBlock x:Name="LoadingMessageText" Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="Looking for open windows…" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="4" Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="OpenFileButton"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Open an app or file"
                Style="{StaticResource PickerButtonStyle}"
                Content="Open app or file…"
                Click="OpenFileButton_Click" />
        <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PickerButtonStyle}" Content="Cancel" IsCancel="True" Click="CancelButton_Click" />
        <Button x:Name="DockButton"
                Grid.Column="2"
                Margin="8,0,0,0"
                MinWidth="108"
                AutomationProperties.Name="Dock selected window"
                Style="{StaticResource PickerPrimaryButtonStyle}"
                Content="Dock window"
                IsDefault="True"
                IsEnabled="False"
                Click="DockButton_Click" />
      </Grid>
    </Grid>
  </Border>
</Window>
