<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="QuickPanel.Views.QuickToolsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PanelBackgroundBrush}">
  <UserControl.Resources>
    <Style x:Key="QuickToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PanelPressButtonStyle}">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
      <Setter Property="Background" Value="{StaticResource PanelSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#252A38" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuickToolTextBoxStyle" TargetType="{x:Type TextBox}">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
      <Setter Property="Background" Value="#121620" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{StaticResource PanelTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="QuickToolCardStyle" TargetType="{x:Type Border}">
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="Padding" Value="13,12" />
      <Setter Property="Background" Value="#121620" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="QuickToolLabelStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="Margin" Value="0,8,0,3" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource PanelMutedTextBrush}" />
    </Style>
    <Style x:Key="UsageBarStyle" TargetType="{x:Type ProgressBar}">
      <Setter Property="Height" Value="8" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Foreground" Value="#6EA8FF" />
      <Setter Property="Background" Value="#202636" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="UseLayoutRounding" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ProgressBar}">
            <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
              <Grid x:Name="PART_Track" ClipToBounds="True">
                <Border x:Name="PART_Indicator"
                        HorizontalAlignment="Left"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="4" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer Focusable="False" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="14,12,14,16">
      <TextBlock x:Name="PanelTitleText" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PanelTextBrush}" Text="Quick Tools" />
      <TextBlock x:Name="PanelSubtitleText" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="Local Quick Panel tools." />

      <Border x:Name="CodexUsageSection" Style="{StaticResource QuickToolCardStyle}">
        <StackPanel>
          <Button x:Name="RefreshCodexUsageButton"
                  HorizontalAlignment="Right"
                  Margin="0"
                  Style="{StaticResource QuickToolButtonStyle}"
                  Content="Refresh"
                  Click="RefreshCodexUsageButton_Click" />
          <ProgressBar x:Name="RefreshActivityBar"
                       Margin="0,4,0,0"
                       Height="3"
                       IsIndeterminate="True"
                       Visibility="Collapsed"
                       Foreground="#46D6C5"
                       Background="#1D2635"
                       BorderThickness="0" />

          <UniformGrid x:Name="UsageWindowsGrid" Margin="0,12,0,0" Columns="2">
            <Border x:Name="PrimaryWindowBorder" Margin="0,0,6,0" Padding="12" Background="#101A2A" BorderBrush="#2A487A" BorderThickness="1" CornerRadius="7">
              <StackPanel>
                <TextBlock x:Name="WindowTitleText" FontSize="10" FontWeight="SemiBold" Foreground="#8DBBFF" Text="Rate-limit window" />
                <TextBlock x:Name="WindowStatusText" Margin="0,5,0,7" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource PanelTextBrush}" Text="waiting" />
                <ProgressBar x:Name="WindowProgressBar" Style="{StaticResource UsageBarStyle}" />
                <TextBlock x:Name="WindowDetailText" Margin="0,8,0,0" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource PanelMutedTextBrush}" Text="Refresh to load API window." />
              </StackPanel>
            </Border>
            <Border x:Name="SecondaryWindowBorder" Margin="6,0,0,0" Padding="12" Background="#102117" BorderBrush="#2D6040" BorderThickness="1" CornerRadius="7">
              <StackPanel>
                <TextBlock x:Name="SecondaryWindowTitleText" FontSize="10" FontWeight="SemiBold" Foreground="#87DFA9" Text="Second rate-limit window" />
                <TextBlock x:Name="WeeklyStatusText" Margin="0,5,0,7" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource PanelTextBrush}" Text="waiting" />
                <ProgressBar x:Name="WeeklyProgressBar" Style="{StaticResource UsageBarStyle}" Foreground="#67D391" />
                <TextBlock x:Name="WeeklyDetailText" Margin="0,8,0,0" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource PanelMutedTextBrush}" Text="Refresh to load API window." />
              </StackPanel>
            </Border>
          </UniformGrid>
          <UniformGrid Margin="0,12,0,0" Columns="2">
            <Border x:Name="BankedStatusBorder" Margin="0,0,6,0" Padding="12" Background="#241F14" BorderBrush="#5C4C25" BorderThickness="1" CornerRadius="7">
              <StackPanel>
                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#F1C36D" Text="Reset credits" />
                <TextBlock x:Name="BankedStatusText" Margin="0,5,0,0" FontSize="10.5" LineHeight="14" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Foreground="{StaticResource PanelTextBrush}" Text="waiting" />
              </StackPanel>
            </Border>
            <Border Margin="6,0,0,0" Padding="12" Background="#111923" BorderBrush="#2D4059" BorderThickness="1" CornerRadius="7">
              <StackPanel>
                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#9BC7E8" Text="Account status" />
                <TextBlock x:Name="TokenStatusText" Margin="0,5,0,0" FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource PanelTextBrush}" Text="waiting" />
              </StackPanel>
            </Border>
          </UniformGrid>
          <TextBlock x:Name="ResetActionStatusText" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource PanelMutedTextBrush}" />
          <Border x:Name="UsageSnapshotBorder" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <Border x:Name="WindowsHelperSection" Style="{StaticResource QuickToolCardStyle}">
        <StackPanel>
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PanelTextBrush}" Text="Windows Helper" />
          <TextBlock Margin="0,3,0,10" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="Useful local actions. Risky actions ask first and report what happened." />
          <WrapPanel>
            <Button Style="{StaticResource QuickToolButtonStyle}" Content="Restart Explorer" Click="RestartExplorerButton_Click" />
            <Button Style="{StaticResource QuickToolButtonStyle}" Content="Clear Temp" Click="ClearTempButton_Click" />
            <Button Style="{StaticResource QuickToolButtonStyle}" Content="Startup Apps" Click="OpenStartupAppsButton_Click" />
            <Button Style="{StaticResource QuickToolButtonStyle}" Content="Bitdefender exclusions" Click="OpenBitdefenderButton_Click" />
            <Button Style="{StaticResource QuickToolButtonStyle}" Content="Portable data folder" Click="OpenPortableDataButton_Click" />
            <Button Style="{StaticResource QuickToolButtonStyle}" Content="Reset config" Click="ResetConfigButton_Click" />
            <Button Style="{StaticResource QuickToolButtonStyle}" Content="Network shares" Click="OpenNetworkSharesButton_Click" />
            <Button Style="{StaticResource QuickToolButtonStyle}" Content="Test connection" Click="TestConnectionButton_Click" />
          </WrapPanel>
          <TextBlock x:Name="WindowsFixStatusText" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource PanelMutedTextBrush}" />
        </StackPanel>
      </Border>

      <Border x:Name="TripPlannerSection" Style="{StaticResource QuickToolCardStyle}">
        <StackPanel>
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PanelTextBrush}" Text="Trip Planner" />
          <TextBlock Margin="0,3,0,10" FontSize="11" Foreground="{StaticResource PanelMutedTextBrush}" Text="Local trip dashboard for packing, maps, budget, and offline notes." />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="TripSelector" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="TripSelector_SelectionChanged" />
            <WrapPanel Grid.Column="1" Margin="8,0,0,0">
              <Button Style="{StaticResource QuickToolButtonStyle}" Content="New trip" Click="NewTripButton_Click" />
              <Button Style="{StaticResource QuickToolButtonStyle}" Content="Delete" Click="DeleteTripButton_Click" />
            </WrapPanel>
          </Grid>

          <TextBlock Style="{StaticResource QuickToolLabelStyle}" Text="Trip name" />
          <TextBox x:Name="TripNameTextBox" Style="{StaticResource QuickToolTextBoxStyle}" />

          <TextBlock Style="{StaticResource QuickToolLabelStyle}" Text="Packing checklist" />
          <Border Padding="9" Background="#0D111A" BorderBrush="{StaticResource PanelBorderSubtleBrush}" BorderThickness="1" CornerRadius="7">
            <StackPanel>
              <StackPanel x:Name="PackingItemsPanel" />
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewPackingItemTextBox" Style="{StaticResource QuickToolTextBoxStyle}" />
                <WrapPanel Grid.Column="1" Margin="8,0,0,0">
                  <Button Style="{StaticResource QuickToolButtonStyle}" Content="Add" Click="AddPackingItemButton_Click" />
                  <Button Style="{StaticResource QuickToolButtonStyle}" Content="Remove checked" Click="RemovePackedButton_Click" />
                </WrapPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource QuickToolLabelStyle}" Text="Saved Google Maps links" />
              <TextBox x:Name="SavedMapsTextBox" Height="64" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource QuickToolTextBoxStyle}" />
              <TextBlock Style="{StaticResource QuickToolLabelStyle}" Text="Camping links" />
              <TextBox x:Name="CampingLinksTextBox" Height="64" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource QuickToolTextBoxStyle}" />
              <TextBlock Style="{StaticResource QuickToolLabelStyle}" Text="Parking spots" />
              <TextBox x:Name="ParkingSpotsTextBox" Height="64" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource QuickToolTextBoxStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource QuickToolLabelStyle}" Text="Fuel estimate notes" />
              <TextBox x:Name="FuelEstimateTextBox" Style="{StaticResource QuickToolTextBoxStyle}" />
              <TextBlock Style="{StaticResource QuickToolLabelStyle}" Text="Daily budget" />
              <TextBox x:Name="DailyBudgetTextBox" Style="{StaticResource QuickToolTextBoxStyle}" />
              <TextBlock Style="{StaticResource QuickToolLabelStyle}" Text="Emergency docs / notes" />
              <TextBox x:Name="EmergencyDocsTextBox" Height="64" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource QuickToolTextBoxStyle}" />
              <TextBlock Style="{StaticResource QuickToolLabelStyle}" Text="Offline notes" />
              <TextBox x:Name="OfflineNotesTextBox" Height="82" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource QuickToolTextBoxStyle}" />
            </StackPanel>
          </Grid>
          <WrapPanel Margin="0,10,0,0">
            <Button Style="{StaticResource QuickToolButtonStyle}" Content="Save trip" Click="SaveTripButton_Click" />
            <Button Style="{StaticResource QuickToolButtonStyle}" Content="Open map links" Click="OpenMapLinksButton_Click" />
          </WrapPanel>
          <TextBlock x:Name="TripStatusText" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource PanelMutedTextBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>