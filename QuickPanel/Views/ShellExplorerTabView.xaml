<UserControl x:Class="QuickPanel.Views.ShellExplorerTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PanelBackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource PanelChromeBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="34" />
          <ColumnDefinition Width="34" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="34" />
        </Grid.ColumnDefinitions>
        <Button x:Name="BackButton" Grid.Column="0" Margin="0,0,4,0" ToolTip="Back" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" Click="BackButton_Click" />
        <Button x:Name="UpButton" Grid.Column="1" Margin="0,0,6,0" ToolTip="Up one folder" Content="&#xE74A;" FontFamily="Segoe Fluent Icons" Click="UpButton_Click" />
        <TextBox x:Name="AddressBox" Grid.Column="2" VerticalContentAlignment="Center" Padding="9,0" KeyDown="AddressBox_KeyDown" />
        <Button Grid.Column="3" Margin="6,0,0,0" ToolTip="Refresh" Content="&#xE72C;" FontFamily="Segoe Fluent Icons" Click="RefreshButton_Click" />
      </Grid>
    </Border>
    <WebBrowser x:Name="Browser" Grid.Row="1" Navigated="Browser_Navigated" />
  </Grid>
</UserControl>
