<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="QuickPanel.Views.TaskManagerTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PanelBackgroundBrush}">
  <UserControl.Resources>
    <SolidColorBrush x:Key="TaskManagerModeIdleBrush" Color="#121824" />
    <Style x:Key="TaskManagerButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelPressButtonStyle}">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
      <Setter Property="Background" Value="#1A2030" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="TaskManagerButtonBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TaskManagerButtonBorder" Property="BorderBrush" Value="{StaticResource PanelAccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="TaskManagerButtonBorder" Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TaskManagerModeButtonStyle" TargetType="Button" BasedOn="{StaticResource TaskManagerButtonStyle}">
      <Setter Property="Width" Value="102" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Background" Value="{StaticResource TaskManagerModeIdleBrush}" />
    </Style>
    <Style x:Key="TaskManagerSummaryCardStyle" TargetType="Border">
      <Setter Property="Height" Value="78" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="#101621" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style x:Key="TaskManagerMetricLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="Foreground" Value="{StaticResource PanelMutedTextBrush}" />
    </Style>
    <Style x:Key="TaskManagerMetricValueStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
    </Style>
    <Style x:Key="HardwareListItemStyle" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,7" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="HardwareCard"
                    Padding="10,9"
                    Background="#101621"
                    BorderBrush="{StaticResource PanelBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HardwareCard" Property="Background" Value="#151C2A" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="HardwareCard" Property="BorderBrush" Value="{StaticResource PanelAccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="Background" Value="#101521" />
      <Setter Property="Foreground" Value="{StaticResource PanelMutedTextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Height" Value="32" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
      <Setter Property="BorderBrush" Value="#151B29" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#151C2A" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource PanelAccentTintBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TaskManagerDataGridCellStyle" TargetType="DataGridCell">
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PanelTextBrush}" Text="Task Manager" />
        <TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource PanelMutedTextBrush}" Text="Processes, performance, and hardware in one panel." />
      </StackPanel>
      <Button x:Name="RefreshButton"
              Grid.Column="1"
              AutomationProperties.Name="Refresh processes"
              Style="{StaticResource TaskManagerButtonStyle}"
              Content="Refresh"
              Click="RefreshButton_Click" />
    </Grid>

    <StackPanel Grid.Row="1" Margin="0,9,0,8" Orientation="Horizontal">
      <Button x:Name="ProcessesModeButton" AutomationProperties.Name="Show processes" Style="{StaticResource TaskManagerModeButtonStyle}" Background="{StaticResource PanelAccentTintBrush}" Content="Processes" Click="ProcessesModeButton_Click" />
      <Button x:Name="PerformanceModeButton" AutomationProperties.Name="Show hardware performance" Style="{StaticResource TaskManagerModeButtonStyle}" Content="Performance" Click="PerformanceModeButton_Click" />
    </StackPanel>

    <Grid x:Name="ProcessesView" Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Margin="0,0,0,7">
        <TextBox x:Name="SearchTextBox"
                 Height="32"
                 Padding="9,0"
                 VerticalContentAlignment="Center"
                 AutomationProperties.Name="Search processes"
                 Background="#0D111A"
                 Foreground="{StaticResource PanelTextBrush}"
                 BorderBrush="{StaticResource PanelBorderBrush}"
                 BorderThickness="1"
                 CaretBrush="{StaticResource PanelTextBrush}"
                 TextChanged="SearchTextBox_TextChanged" />
        <TextBlock x:Name="SearchPlaceholder"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   FontSize="11"
                   Foreground="{StaticResource PanelMutedTextBrush}"
                   Text="Search by name, PID, or window" />
      </Grid>

      <Border Grid.Row="1" Margin="0,0,0,7" Padding="9,7" Background="#101621" BorderBrush="{StaticResource PanelBorderSubtleBrush}" BorderThickness="1" CornerRadius="7">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="SelectionTitleText" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource PanelTextBrush}" Text="Select a process" />
            <TextBlock x:Name="SelectionDetailText" Margin="0,2,8,0" MaxHeight="30" FontSize="9.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource PanelMutedTextBrush}" Text="Choose a row to see its PID, status, window, and actions." />
          </StackPanel>
          <Button x:Name="OpenLocationButton" Grid.Column="1" AutomationProperties.Name="Open process file location" ToolTip="Open the selected executable in File Explorer" Style="{StaticResource TaskManagerButtonStyle}" Content="File location" IsEnabled="False" Click="OpenLocationButton_Click" />
          <Button x:Name="EndTaskButton" Grid.Column="2" AutomationProperties.Name="End selected task" ToolTip="End the selected process after confirmation" Style="{StaticResource TaskManagerButtonStyle}" Background="#32191D" BorderBrush="#6B2D36" Foreground="#FFB7BE" Content="End task" IsEnabled="False" Click="EndTaskButton_Click" />
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="#0B0F17" BorderBrush="{StaticResource PanelBorderSubtleBrush}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
        <DataGrid x:Name="ProcessGrid"
                  AutomationProperties.Name="Running processes"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  RowHeaderWidth="0"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="{StaticResource PanelTextBrush}"
                  HorizontalScrollBarVisibility="Disabled"
                  CellStyle="{StaticResource TaskManagerDataGridCellStyle}"
                  SelectionChanged="ProcessGrid_SelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.4*" MinWidth="130" />
            <DataGridTextColumn Header="CPU" Binding="{Binding CpuPercent, StringFormat={}{0:0.0}%}" Width="62" />
            <DataGridTextColumn Header="Memory" Binding="{Binding MemoryMegabytes, StringFormat={}{0:N0} MB}" Width="84" />
            <DataGridTextColumn x:Name="ProcessIdColumn" Header="PID" Binding="{Binding ProcessId}" Width="60" />
            <DataGridTextColumn x:Name="ProcessStatusColumn" Header="Status" Binding="{Binding Status}" Width="82" />
            <DataGridTextColumn x:Name="ProcessWindowColumn" Header="Window" Binding="{Binding WindowTitle}" Width="1.4*" MinWidth="120" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Grid Grid.Row="3" Margin="1,7,1,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" FontSize="10.5" TextTrimming="CharacterEllipsis" Foreground="{StaticResource PanelMutedTextBrush}" Text="Loading processes…" />
        <TextBlock x:Name="SummaryText" Grid.Column="1" Margin="12,0,0,0" FontSize="10.5" Foreground="{StaticResource PanelMutedTextBrush}" />
      </Grid>
    </Grid>

    <Grid x:Name="PerformanceView" Grid.Row="2" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <UniformGrid x:Name="SummaryGrid" Columns="2" Margin="0,0,-6,2">
        <Border Style="{StaticResource TaskManagerSummaryCardStyle}">
          <StackPanel>
            <TextBlock FontSize="9.5" Foreground="{StaticResource PanelMutedTextBrush}" Text="CPU" />
            <TextBlock x:Name="CpuSummaryText" Margin="0,3,0,0" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource PanelTextBrush}" Text="Loading…" />
            <Canvas x:Name="CpuChartCanvas" Height="18" Margin="0,5,0,0" ClipToBounds="True">
              <Polyline x:Name="CpuChartLine" Stroke="#6B8FFF" StrokeThickness="1.5" StrokeLineJoin="Round" />
            </Canvas>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource TaskManagerSummaryCardStyle}">
          <StackPanel>
            <TextBlock FontSize="9.5" Foreground="{StaticResource PanelMutedTextBrush}" Text="RAM" />
            <TextBlock x:Name="MemorySummaryText" Margin="0,3,0,0" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource PanelTextBrush}" Text="Loading…" />
            <Canvas x:Name="MemoryChartCanvas" Height="18" Margin="0,5,0,0" ClipToBounds="True">
              <Polyline x:Name="MemoryChartLine" Stroke="#A78BFA" StrokeThickness="1.5" StrokeLineJoin="Round" />
            </Canvas>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource TaskManagerSummaryCardStyle}">
          <StackPanel>
            <TextBlock FontSize="9.5" Foreground="{StaticResource PanelMutedTextBrush}" Text="GPU" />
            <TextBlock x:Name="GpuSummaryText" Margin="0,3,0,0" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource PanelTextBrush}" Text="Loading…" />
            <Canvas x:Name="GpuChartCanvas" Height="18" Margin="0,5,0,0" ClipToBounds="True">
              <Polyline x:Name="GpuChartLine" Stroke="#34D399" StrokeThickness="1.5" StrokeLineJoin="Round" />
            </Canvas>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource TaskManagerSummaryCardStyle}">
          <StackPanel>
            <TextBlock FontSize="9.5" Foreground="{StaticResource PanelMutedTextBrush}" Text="STORAGE" />
            <TextBlock x:Name="StorageSummaryText" Margin="0,3,0,0" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource PanelTextBrush}" Text="Loading…" />
            <Canvas x:Name="StorageChartCanvas" Height="18" Margin="0,5,0,0" ClipToBounds="True">
              <Polyline x:Name="StorageChartLine" Stroke="#FBBF24" StrokeThickness="1.5" StrokeLineJoin="Round" />
            </Canvas>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource TaskManagerSummaryCardStyle}">
          <StackPanel>
            <TextBlock FontSize="9.5" Foreground="{StaticResource PanelMutedTextBrush}" Text="TEMPERATURE" />
            <TextBlock x:Name="TemperatureSummaryText" Margin="0,3,0,0" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource PanelTextBrush}" Text="Loading…" />
            <Canvas x:Name="TemperatureChartCanvas" Height="18" Margin="0,5,0,0" ClipToBounds="True">
              <Polyline x:Name="TemperatureChartLine" Stroke="#FB7185" StrokeThickness="1.5" StrokeLineJoin="Round" />
            </Canvas>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource TaskManagerSummaryCardStyle}">
          <StackPanel>
            <TextBlock FontSize="9.5" Foreground="{StaticResource PanelMutedTextBrush}" Text="FANS" />
            <TextBlock x:Name="FanSummaryText" Margin="0,3,0,0" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource PanelTextBrush}" Text="Loading…" />
            <Canvas x:Name="FanChartCanvas" Height="18" Margin="0,5,0,0" ClipToBounds="True">
              <Polyline x:Name="FanChartLine" Stroke="#38BDF8" StrokeThickness="1.5" StrokeLineJoin="Round" />
            </Canvas>
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Grid.Row="1" Background="#0B0F17" BorderBrush="{StaticResource PanelBorderSubtleBrush}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
        <ListBox x:Name="HardwareList"
                 AutomationProperties.Name="Hardware performance devices"
                 Padding="7,7,7,0"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="{StaticResource PanelTextBrush}"
                 ItemContainerStyle="{StaticResource HardwareListItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Margin="0,0,8,0" Padding="7,2" VerticalAlignment="Center" Background="{StaticResource PanelAccentTintBrush}" CornerRadius="9">
                    <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource PanelTextBrush}" Text="{Binding Category}" />
                  </Border>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource PanelTextBrush}" Text="{Binding Name}" />
                </Grid>
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,8,0,0">
                  <StackPanel Margin="0,0,5,0">
                    <TextBlock Style="{StaticResource TaskManagerMetricLabelStyle}" Text="USAGE" />
                    <TextBlock Style="{StaticResource TaskManagerMetricValueStyle}" Text="{Binding Usage}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,5,0">
                    <TextBlock Style="{StaticResource TaskManagerMetricLabelStyle}" Text="TEMP" />
                    <TextBlock Style="{StaticResource TaskManagerMetricValueStyle}" Text="{Binding Temperature}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,5,0">
                    <TextBlock Style="{StaticResource TaskManagerMetricLabelStyle}" Text="FAN" />
                    <TextBlock Style="{StaticResource TaskManagerMetricValueStyle}" Text="{Binding Fan}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Style="{StaticResource TaskManagerMetricLabelStyle}" Text="CAPACITY" />
                    <TextBlock Style="{StaticResource TaskManagerMetricValueStyle}" Text="{Binding Capacity}" />
                  </StackPanel>
                </UniformGrid>
                <TextBlock Grid.Row="2" Margin="0,7,0,0" FontSize="9.5" TextWrapping="Wrap" Foreground="{StaticResource PanelMutedTextBrush}" Text="{Binding Details}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <StackPanel Grid.Row="2" Margin="1,7,1,0">
        <TextBlock x:Name="HardwareStatusText" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource PanelMutedTextBrush}" Text="Open Performance to read hardware sensors." />
        <TextBlock x:Name="HardwareUpdatedText" Margin="0,2,0,0" HorizontalAlignment="Right" FontSize="9.5" Foreground="{StaticResource PanelMutedTextBrush}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
